# asynq Worker 镜像（M2）。与 server 共用构建阶段，只是入口换成 ./cmd/worker。
FROM golang:1.26.5@sha256:7caba5286b4c3613a337b709c573047d8ae62ee76106647313b61e72b99f20af AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /bin/kbot-worker ./cmd/worker

# 运行阶段：distroless，无 shell、攻击面小。
FROM gcr.io/distroless/static-debian12@sha256:6447365a6337c3732f412d1b74357b30a633831955b2bc45552b0086be907687
WORKDIR /app
COPY --from=build /bin/kbot-worker /kbot-worker
ENTRYPOINT ["/kbot-worker"]
