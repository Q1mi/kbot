FROM golang:1.26.5@sha256:7caba5286b4c3613a337b709c573047d8ae62ee76106647313b61e72b99f20af AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /bin/kbot-sandbox-runner ./cmd/sandbox-runner

# Runner 需要 Docker CLI 连接宿主 daemon；业务代码在独立的一次性容器中运行。
FROM docker:27-cli@sha256:851f91d241214e7c6db86513b270d58776379aacc5eb9c4a87e5b47115e3065c
COPY --from=build /bin/kbot-sandbox-runner /usr/local/bin/kbot-sandbox-runner
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/kbot-sandbox-runner"]
