# ===== kbot .env.example =====
# 复制为 .env 后编辑:cp .env.example .env
# .env 已在 .gitignore,绝不提交。

# --- 服务监听 ---
KBOT_ADDR=:8080
KBOT_ENVIRONMENT=dev               # dev | staging | prod
KBOT_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# --- 数据库(容器内主机名 db) ---
KBOT_DATABASE_URL=postgres://kbot:kbot@db:5432/kbot?sslmode=disable

# --- Redis(容器内主机名 redis) ---
KBOT_REDIS_URL=redis://redis:6379/0

# --- 独立 Sandbox Runner ---
KBOT_SANDBOX_RUNNER_URL=http://sandbox-runner:8081
# 生产环境请使用 Secret 管理并生成独立随机值：openssl rand -base64 48 | tr -d '\n='
KBOT_SANDBOX_RUNNER_TOKEN=请改我__sandbox_runner_internal_token_32_chars
KBOT_SANDBOX_PYTHON_IMAGE=python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7
KBOT_SANDBOX_BASH_IMAGE=busybox:1.37.0@sha256:9db7b59979c38555a39def84a31fb98b5296952f9e3afd4f6f11f05b07adfab0
KBOT_SANDBOX_MEMORY_MB=256
KBOT_SANDBOX_CPUS=0.5
KBOT_SANDBOX_PIDS_LIMIT=64
KBOT_SANDBOX_TMPFS_MB=64
KBOT_SANDBOX_TIMEOUT=30s
KBOT_SANDBOX_MAX_CODE_BYTES=65536
KBOT_SANDBOX_MAX_OUTPUT_BYTES=1048576
KBOT_SANDBOX_MAX_CONCURRENT=4

# --- 对象存储(MinIO,容器内主机名 minio) ---
KBOT_S3_ENDPOINT=http://minio:9000
KBOT_S3_BUCKET=kbot
KBOT_S3_ACCESS_KEY=kbot
KBOT_S3_SECRET_KEY=kbot123456

# --- JWT(必填,长度 ≥ 32) ---
# 生成方法:openssl rand -base64 48 | tr -d '\n='
KBOT_JWT_SECRET_KEY=请改我__示例__32_chars_minimum_for_dev_only
# Provider API Key 的 AES-GCM 应用层加密密钥；生产请与 JWT 密钥分开并由 Secret 管理。
KBOT_CREDENTIAL_ENCRYPTION_KEY=请改我__provider_api_key_encryption_key

# --- LLM Gateway(旧配置兼容回退；新项目在 Admin 中创建 Provider Account) ---
# 推荐(国内):
#   DeepSeek: https://platform.deepseek.com → API Keys
#   智谱 GLM: https://open.bigmodel.cn
# 国外:
#   OpenAI: https://platform.openai.com/api-keys
KBOT_LLM_BASE_URL=https://api.deepseek.com/v1
KBOT_LLM_API_KEY=
KBOT_LLM_MODEL=deepseek-chat
KBOT_LLM_CHEAP_MODEL=deepseek-chat   # M3 元提示词用便宜模型时同名也可

# --- 本地 Ollama（可选，配合 Compose local-llm profile） ---
# secret 分级只允许本地模型；此地留空时 secret 请求会失败关闭。
KBOT_OLLAMA_BASE_URL=
KBOT_OLLAMA_MODEL=qwen2.5:7b

# --- KB 向量化嵌入器 ---
# local:离线确定性(词袋哈希),make up 即开即用,无需网络/密钥;无语义理解但足以演示检索链路。
# openai:走上面的 LLM Gateway /embeddings 端点(需真实 KBOT_LLM_API_KEY),真实语义检索。
KBOT_EMBEDDER=local
KBOT_EMBEDDER_DIM=1536               # 必须 == kb_chunks.embedding vector(1536);改维度要新表+重灌 KB(ADR 0006)
KBOT_EMBEDDER_MODEL=text-embedding-3-small

# --- 可观测(可选;留空禁用 trace 导出) ---
KBOT_OTLP_ENDPOINT=
# 如启用 Langfuse:KBOT_OTLP_ENDPOINT=https://us.cloud.langfuse.com/api/public/otel/v1/traces
# Header 格式为逗号分隔 key=value；Langfuse Authorization 使用 Basic base64(public:secret)。
KBOT_OTLP_HEADERS=
KBOT_OTEL_SAMPLE_RATIO=1             # 0..1；生产按流量与成本下调
KBOT_OTEL_CAPTURE_CONTENT=false      # 生产默认关闭，避免采集 Prompt/响应中的敏感内容
KBOT_SERVICE_VERSION=dev
KBOT_LANGFUSE_UI_URL=                # 浏览器可访问的地址，如 http://localhost:3000
KBOT_LANGFUSE_PROJECT_ID=            # 用于 Admin 拼接 Trace 深链
# 自托管课堂环境已在 Compose overlay 中配好以上变量，详见 docs/labs/langfuse-a2ui-demo.md。

# --- Integration(可选) ---
KBOT_WEBHOOK_SECRET=                # 入站 webhook HMAC 校验 secret;留空禁用
KBOT_LARK_VERIFY_TOKEN=             # 飞书入站 verification token
KBOT_LARK_ENCRYPT_KEY=              # 可选；配置后校验 X-Lark-Signature
KBOT_LARK_APP_ID=                   # 飞书出站需要
KBOT_LARK_APP_SECRET=
KBOT_LARK_AGENT_ID=                 # 飞书消息默认触发的 Agent ID

# --- Audit 留证 ---
# 月分区超过该月龄 → 导出 MinIO(kbot-archive 桶)后 detach+drop。默认 13(约保留 1 年热数据)。
KBOT_AUDIT_ARCHIVE_AFTER_MONTHS=13

# --- 首启自动 seed admin(仅 dev,prod 必须改 false) ---
KBOT_AUTOSEED_ADMIN=true
KBOT_AUTOSEED_ADMIN_EMAIL=admin@example.com
KBOT_AUTOSEED_ADMIN_PASSWORD=admin12345
KBOT_AUTOSEED_COURSE_ASSETS=false
KBOT_TOOL_ALLOWED_HOSTS=crossborder-sim,insurance-sim
KBOT_TOOL_ALLOW_PRIVATE_NETWORK=false
KBOT_KB_MARKDOWN_ALLOWED_ROOTS=projects
