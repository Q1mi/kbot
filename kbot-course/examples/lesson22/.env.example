# 在仓库根目录执行：
# cp examples/lesson22/.env.example examples/lesson22/.env
# 编辑 .env 后执行：set -a; source examples/lesson22/.env; set +a
# .env 已被 .gitignore 排除。程序通过环境变量读取配置。

# 飞书开放平台 → 企业自建应用 → 凭证与基础信息
KBOT_LARK_APP_ID='cli_replace_me'
KBOT_LARK_APP_SECRET='replace_me'

# 可选：限制为指定飞书租户；为空时仍检查事件 app_id 和发送者 tenant 一致。
KBOT_LARK_TENANT_KEY=''

# 可选：make feishu-demo ARGS='-live-model' 使用真实模型。
# 默认演示模型生成确定性物流 tool_call，无需模型凭据。
ARK_API_KEY=''
KBOT_LLM_MODEL='doubao-seed-2-0-lite-260215'
KBOT_LLM_BASE_URL='https://ark.cn-beijing.volces.com/api/v3'

# 以下映射供 make run 的完整主服务使用。
# make feishu-demo 自动创建隔离的内存 Workspace、Agent 和 dev 版本。
# KBOT_CHANNEL_WORKSPACE_ID='你的 Workspace ID'
# KBOT_CHANNEL_AGENT_ID='你的 Agent ID'
# KBOT_CHANNEL_AGENT_ENV='dev'
