# Copy to .env, replace placeholders, then: source .env
# Use the base URL of the region/instance in which your Langfuse project lives.
export LANGFUSE_BASE_URL='https://cloud.langfuse.com'
export LANGFUSE_PUBLIC_KEY='pk-lf-replace-me'
export LANGFUSE_SECRET_KEY='sk-lf-replace-me'

LANGFUSE_AUTH=$(printf '%s:%s' "$LANGFUSE_PUBLIC_KEY" "$LANGFUSE_SECRET_KEY" | base64 | tr -d '\r\n')
export OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="${LANGFUSE_BASE_URL%/}/api/public/otel/v1/traces"
export OTEL_EXPORTER_OTLP_TRACES_HEADERS="Authorization=Basic ${LANGFUSE_AUTH},x-langfuse-ingestion-version=4"
unset LANGFUSE_AUTH

# Explicitly enable content capture for the synthetic classroom data.
export KBOT_TRACE_CONTENT=true
export KBOT_TRACE_ENVIRONMENT=development
